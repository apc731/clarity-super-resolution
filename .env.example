# 复制成 .env 后按需修改；所有项都有默认值，不填也能跑。
# 默认值写在 backend/app/config.py 里，这里只是列出可调项。

# 服务
HOST=127.0.0.1
PORT=8000

# 数据目录（上传、结果、临时文件）；相对路径按仓库根目录解析
# DATA_DIR=.data
# UPLOAD_DIR=.data/uploads
# RESULT_DIR=.data/results

# Real-ESRGAN 源码目录（提供 basicsr / realesrgan / gfpgan 包）
# 留空会自动在仓库同级、E:/、D:/、~/ 下找；也可以改成 pip 安装后的环境（则不填）
REALESRGAN_ROOT=E:/Real-ESRGAN

# 权重目录，留空则用 $REALESRGAN_ROOT/weights
# WEIGHTS_DIR=

# 推理参数
TILE_SIZE=512          # 0 表示整图推理（大图会爆显存且慢一个数量级）
TILE_PAD=10
HALF_PRECISION=1       # CUDA 下用 fp16
PRE_PAD=0
DEVICE=auto            # auto | cpu

# 上传限制
MAX_UPLOAD_MB=20
MAX_INPUT_PIXELS=24000000
# ALLOWED_EXTS=jpg,jpeg,png,webp,bmp,tif,tiff

# 输出规格
PREVIEW_MAX_SIDE=2048
PREVIEW_QUALITY=88
THUMBNAIL_WIDTH=480

# 队列与清理
MAX_QUEUE=4            # 排队上限，超出直接拒绝（GPU 一次只跑一个任务）
TASK_KEEP_HOURS=24     # 结果文件保留时长，过期自动删

# 跨域（开发模式下前端在 :3000）
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
